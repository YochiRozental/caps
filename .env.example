# תבנית משתני סביבה לתשלומים. אין כאן ערכים אמיתיים. העתיקו ל-.env והשלימו מקומית.
# ברירת מחדל: בלי PAYMENT_PROVIDER אין תשלומים כלל.

# none | mock | grow (Grow: שלב Sandbox בלבד כרגע - ראו משתני GROW_* למטה)
PAYMENT_PROVIDER=none

# sandbox = בדיקות; live = סליקה אמיתית. חובה להצהיר במפורש (לא נגזר מ-NODE_ENV)
PAYMENT_ENVIRONMENT=sandbox

# ספק ה-Mock עולה רק אם כל אלה מתקיימים: PAYMENT_PROVIDER=mock, PAYMENT_ENVIRONMENT=sandbox,
# PAYMENT_MOCK_ENABLED=true, NODE_ENV != production, ו-DATABASE_URL מצביע למסד מקומי (localhost/127.0.0.1).
# לעולם לא להגדיר באתר החי.
PAYMENT_MOCK_ENABLED=false

# חריג לשלב הפיתוח בלבד: true מתיר ל-Mock לעבוד גם על שרת מותקן (NODE_ENV=production) ומסד מרוחק.
# מתאים רק כשאין באתר לקוחות או כסף אמיתיים. להסיר לפני חיבור סליקה אמיתית או קבלת לקוחות.
PAYMENT_MOCK_ALLOW_DEPLOYED=false

# כשהחריג למעלה פעיל: תשלומי הדמה מוגבלים בצד השרת למנהלים ולמשתמשי בדיקה ברשימה (אימיילים, מופרדים בפסיקים).
# לקוח שאינו ברשימה לא רואה את זרימת התשלום/המשמרות וממשיך בהזמנה הרגילה. בלי רשימה: רק מנהלים.
PAYMENT_MOCK_TEST_USERS=

# true מבטל את ההגבלה למנהלים/משתמשי בדיקה כליל: כל משתמש מחובר יכול להשלים תשלום דמה (גם בהזמנות וגם במשמרות).
# פועל רק כש-PAYMENT_PROVIDER=mock כבר פעיל בפועל (לא מפעיל Mock בעצמו ולא משפיע על סביבה חיה).
# לסגור רק את המשמרות בלי להשפיע על דגל זה: SHIFTS_ENABLED=false. להסיר (false) לפני חיבור סליקה אמיתית או קבלת לקוחות.
PAYMENT_MOCK_OPEN_TO_ALL=false

# סוד לחתימת webhook (לפחות 16 תווים אקראיים). ל-Mock בלבד בשלב זה
PAYMENT_WEBHOOK_SECRET=

# ספק Grow (Meshulam) - שלב Sandbox בלבד. ראו דוח ההיתכנות ו-grow-provider.ts: מבנה התשובה של כמה נקודות קצה
# עדיין לא אומת מול Sandbox אמיתי. אסור להגדיר PAYMENT_ENVIRONMENT=live עבור Grow בשלב זה.
# מזהי העסק (ייחודיים לכל חשבון Grow; מתקבלים מהתמיכה של Grow, נפרדים בין Sandbox ל-Production):
GROW_USER_ID=
GROW_PAGE_CODE=
# כתובת בסיס ה-API. ל-Sandbox יש ברירת מחדל בקוד (https://sandbox.meshulam.co.il/api/light/server/1.0/);
# ל-Production אין ברירת מחדל ידועה בתיעוד - יש להגדיר במפורש רק אחרי קבלת האישור והכתובת הרשמית מ-Grow.
GROW_API_BASE_URL=
# עמוד ההצלחה/ביטול שאליו Grow מחזיר את הלקוח (HTTPS, לא localhost - דרישת Grow)
GROW_SUCCESS_URL=
GROW_CANCEL_URL=
# אופציונלי: נקודת הקצה ל-webhook שלנו (קיימת: /api/payments/webhook/grow). ייתכן שנדרשת גם הרשמה ידנית מול
# התמיכה של Grow בנוסף לפרמטר הזה - לא היה ברור חד-משמעית בתיעוד (ראו דוח ההיתכנות)
GROW_NOTIFY_URL=
# חריג מפורש בלבד: מתיר ל-Grow לרוץ מחוץ ל-sandbox. אין להגדיר true לפני בדיקה מלאה מול Sandbox ואישור Production מ-Grow
GROW_ALLOW_LIVE=false

# שמור להמשך, שלב נפרד (אחרי שלב Sandbox של Grow): פינבוט - הפקת חשבונית/קבלה בלבד (לא סליקה).
# השמות יקבעו סופית רק לאחר אימות התיעוד הרשמי של Finbot

# בדיקות אינטגרציה של תשלומים והחזקות (npm test): מסד מקומי בלבד ששמו מסתיים ב-_test. בלי זה הבדיקות מדולגות.
# PAYMENTS_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_payments_test
# שער הגדרת הקוד הטלפוני באתר (עמוד /profile/ivr-pin ונתיב /api/profile/ivr-pin). סגור כברירת מחדל; לפתיחה: true.
# לפתוח רק אחרי שהמיגרציה ivr_pin_and_throttle הוחלה בסביבה
IVR_PIN_SETUP_ENABLED=false

# תשלום בטלפון (IVR): סגור כברירת מחדל; כשסגור ה-IVR פועל בדיוק כמו קודם (הזמנה מאושרת מיד, בלי תשלום).
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית, ראו PAYMENT_*), ורק אם הפאנל של ימות המשיח שולח POST
IVR_PAYMENTS_ENABLED=false

# שמירת כרטיס מדומה באתר (בדיקות בלבד): סגור כברירת מחדל; פעיל רק מול ספק Mock בסביבת sandbox. אינו מקבל פרטי כרטיס
MOCK_SAVED_CARD_ENABLED=false

# בדיקות שירותי הכרטיס השמור וההרשאה החד-פעמית, ובדיקות זרימת התשלום בטלפון (npm test): מסדים מקומיים נפרדים (_test)
# SAVEDCARD_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_savedcard_test
# IVRPAY_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_ivrpay_test

# בדיקות הקוד הטלפוני והגבלת הניסיונות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# PIN_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_pin_test

# בדיקות הזרימה האמיתית של ה-IVR בשתי השיטות GET/POST (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# IVR_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_ivr_test

# בדיקות חבילות ויתרות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test (הקבצים רצים במקביל ולכן לא חולקים מסד)
# PACKAGES_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_packages_test

# משמרות קבועות וחיוב חודשי: סגור כברירת מחדל. כשסגור אין עמוד משמרות, אין יצירה, אין חיוב חודשי וה-Cron העסקי אינו פועל.
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית); בכל סביבה חיה נשאר false
SHIFTS_ENABLED=false

# סוד לנתיב ה-Cron (POST /api/cron/shift-billing, Authorization: Bearer ...). בלי סוד הנתיב מחזיר 404
CRON_SECRET=

# בדיקות משמרות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# SHIFTS_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_shifts_test

# ניהול כספי למנהל (שלב H): סגור כברירת מחדל. כשסגור אין מסכי ניהול כספי, אין נתיבי API חדשים ואין פעולות כספיות חדשות.
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית); בכל סביבה חיה נשאר false
FINANCE_ADMIN_ENABLED=false

# בדיקות הניהול הכספי (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# FINANCE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_finance_test

# גלריית תמונות: אחסון הקבצים עצמם ב-Cloudinary (חובה כדי שהעלאת תמונות תעבוד).
# הערכים נמצאים בלוח הבקרה של Cloudinary (Dashboard): Cloud Name, API Key, API Secret.
# אין לחשוף את API_SECRET בצד לקוח — הוא משמש רק בשרת (route handlers), לעולם לא ב-NEXT_PUBLIC_*
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# שער גישה לסביבת Staging בלבד (הכנה לחיבור Grow דרך Make). כבוי כברירת מחדל: בלי STAGING_GATE_ENABLED=true
# מפורש אין שום הגנה נוספת, וההתנהגות זהה לחלוטין להיום. גם כשמוגדר, השער פועל בפועל רק כש-הדיפלוי עצמו
# מוכר כלא-Production. הזהות הזו נקבעת לפי RENDER_EXTERNAL_HOSTNAME - משתנה שהפלטפורמה של Render מזריקה
# אוטומטית לכל שירות (לעולם אין להגדיר אותו כאן או ידנית) - ולא לפי כותרת Host של הבקשה הנכנסת, כדי שלא
# יהיה ניתן לעקוף את השער ע"י זיוף הכותרת, וגם לא יהיה ניתן להפעילו בטעות ב-Production ע"י זיוף דומה. כך
# גם העתקה בטעות של המשתנים האלה לשירות ה-Production (או ל-main) לא תחסום לקוחות אמיתיים. אותו משתנה
# משמש גם לבניית כתובת ההפניה הציבורית הנכונה (למשל אחרי התחברות) - מאחורי ה-Proxy הפנימי של Render
# הכתובת של הבקשה עצמה עשויה להיות פנימית (כגון localhost:10000) ולא ניתן להפנות אליה את הדפדפן. ראו
# src/lib/staging-gate/config.ts.
STAGING_GATE_ENABLED=false
# סיסמת הגישה לדפדפן (עמוד /staging-login). לפחות 12 תווים. אין לשים כאן ערך אמיתי בריפו - רק ב-Render.
STAGING_GATE_PASSWORD=
# מפתח נפרד לאימות שרת-לשרת (לדוגמה: תרחישי Make), בכותרת x-staging-service-key. לפחות 24 תווים. לא חובה -
# בלעדיו בקשות Make לא יוכלו לעקוף את עמוד ההתחברות האנושי, ויידחו כמו כל בקשה לא-מאומתת אחרת. חשוב: המפתח
# הזה פותח רק נתיבי API שהוגדרו במפורש ב-SERVICE_KEY_ALLOWED_PATHS (src/lib/staging-gate/config.ts) - כרגע
# הרשימה ריקה בכוונה (אין עדיין נתיב Make מאושר), כך שהמפתח לא פותח כלום עד שנתיב ה-Make בפועל יתווסף לקוד.
STAGING_GATE_SERVICE_KEY=
# רשימת מארחים נוספים (מופרדים בפסיקים) שמותר להפעיל בהם את השער, מעבר לכתובת ה-Staging הידועה. נבדקת מול
# RENDER_EXTERNAL_HOSTNAME, לא מול כותרת הבקשה. להשאיר ריק אלא אם יש כתובת Staging נוספת (דומיין מותאם אישית).
STAGING_GATE_EXTRA_HOSTS=

# ספק Make (PAYMENT_PROVIDER=make): הקפסולה -> Make -> Grow Sandbox. חסום בקוד כל עוד אימות עסקאות דרך Make לא מומש
# (MAKE_PROVIDER_VERIFICATION_READY ב-src/lib/payments/make-provider.ts), גם אם המשתנים כאן מלאים. סודות: לא לשמור בקוד.
# כתובת ה-Custom webhook של התרחיש (HTTPS בלבד)
MAKE_PAYMENT_WEBHOOK_URL=
# הערך שהתרחיש מצפה לו בכותרת x-make-apikey. לפחות 24 תווים
MAKE_PAYMENT_API_KEY=
# דומייני ה-checkout המאושרים של Grow (מופרדים בפסיקים, שמות מארח בלבד). חובה; ללא ברירת מחדל - מגדירים לפי הקישור האמיתי ב-Sandbox
MAKE_PAYMENT_CHECKOUT_HOSTS=

# כלי אבחון תקשורת אתר -> Make (/admin/make-diagnostics). זמני, ל-Staging בלבד: פעיל רק עם MAKE_DIAG_ENABLED=true וגם כששער ה-Staging פעיל.
# ב-Production להשאיר כבוי/לא מוגדר. התרחיש השני (אימות) משתמש בכתובת ובמפתח משלו; הערכים סודיים ולא נחשפים בממשק.
MAKE_DIAG_ENABLED=false
MAKE_VERIFY_WEBHOOK_URL=
MAKE_VERIFY_API_KEY=

# קישור בדיקה קבוע ל-Grow Sandbox (כפתור בדף /admin/make-diagnostics). חייב להיות HTTPS בדומיין sandbox.meshulam.co.il. לבדיקות בלבד.
GROW_SANDBOX_TEST_CHECKOUT_URL=
